{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LightHub semantic preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "modelId", "rate", "dpi", "defaultIndex", "shiftIndex", "bindings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "modelId": { "type": "string", "minLength": 1 },
    "rate": { "enum": [125, 250, 500, 1000] },
    "dpi": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
    "defaultIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
    "shiftIndex": { "enum": [0, 1, 2, 3, 4, 255] },
    "bindings": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["control", "action"],
        "properties": {
          "control": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "contentEncoding": "base64", "description": "Exactly four decoded bytes; unknown actions may only be preserved unchanged on a matching target." }
        }
      }
    }
  }
}
