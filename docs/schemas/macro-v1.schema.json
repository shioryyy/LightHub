{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LightHub bounded keyboard macro v1 (local semantics only)",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "execution", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "execution": { "const": "single" },
    "events": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "usage", "delayMs"],
        "oneOf": [
          { "properties": { "kind": { "enum": ["down", "up"] }, "usage": { "type": "integer", "anyOf": [{"minimum": 4, "maximum": 115}, {"minimum": 224, "maximum": 231}] }, "delayMs": { "const": 0 } } },
          { "properties": { "kind": { "const": "delay" }, "usage": { "const": 0 }, "delayMs": { "type": "integer", "minimum": 1, "maximum": 10000 } } }
        ],
        "properties": { "kind": {}, "usage": {}, "delayMs": {} }
      }
    }
  },
  "description": "Application validation additionally enforces balanced key state, at most six held non-modifier keys and at most 30000 ms of explicit delays. This schema does not enable device execution."
}
