<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LightHub.Desktop.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Noto Sans CJK SC, sans-serif"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#20282D"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="34"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="12,6"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#00795F"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.hotspot"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#20282D"/><Setter Property="BorderBrush" Value="#637078"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.hotspot.selected"><Setter Property="Background" Value="#00795F"/><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style Selector="ListBox#ButtonList ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#637078"/></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Border.dpi-stage"><Setter Property="BorderBrush" Value="#DFE4E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="#F8FAFA"/></Style>
    <Style Selector="Border.dpi-stage.current"><Setter Property="BorderBrush" Value="#00795F"/><Setter Property="Background" Value="#F0F7F5"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="36"/><Setter Property="FormatString" Value="0"/></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="15"/></Style>
  </Application.Styles>
</Application>
