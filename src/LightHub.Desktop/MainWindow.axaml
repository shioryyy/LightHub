<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LightHub.Desktop" x:Class="LightHub.Desktop.MainWindow" Title="LightHub" Width="1120" Height="800" MinWidth="960" MinHeight="680" Background="#FFFFFF">
  <Grid RowDefinitions="64,*,64" ColumnDefinitions="228,*">
    <Border Grid.ColumnSpan="2" Background="#F4F6F7" BorderBrush="#DFE4E7" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="LightHub" FontSize="24" FontWeight="Bold"/><TextBlock Text="0.3 ALPHA" Classes="muted" VerticalAlignment="Center" FontSize="11"/></StackPanel>
        <ComboBox Grid.Column="1" Width="104" Name="Language" SelectionChanged="LanguageChanged" Margin="0,0,12,0"><ComboBoxItem Content="English"/><ComboBoxItem Content="简体中文"/></ComboBox>
        <Button Grid.Column="2" Content="{Binding L[About]}" Click="AboutClicked"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#F4F6F7" BorderBrush="#DFE4E7" BorderThickness="0,0,1,0" Padding="14,20">
      <Grid RowDefinitions="Auto,Auto,*,100,Auto">
        <TextBlock Text="{Binding L[Devices]}" Classes="section" Margin="8,0,0,14"/>
        <Button Grid.Row="1" Content="{Binding L[Scan]}" Click="ScanClicked" IsEnabled="{Binding Idle}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding Devices}" Name="DeviceList" SelectionChanged="DeviceChanged" Background="Transparent" IsEnabled="{Binding Idle}">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="5" Margin="2,8"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" FontSize="10" Foreground="#637078"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Image Grid.Row="3" Source="avares://LightHub.Desktop/Assets/mouse.png" Height="90" Opacity="0.8" Stretch="Uniform"/>
        <TextBlock Grid.Row="4" Text="{Binding DiscoverySummary}" Classes="muted" TextWrapping="Wrap" Margin="8,12,8,0" FontSize="11"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" Margin="26,12,26,12">
      <Grid Name="DeviceHeading" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <StackPanel Spacing="4"><TextBlock Text="{Binding DeviceName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding DeviceDetails}"/><TextBlock Text="{Binding SupportBadge}" Foreground="#00795F" FontSize="11" TextWrapping="Wrap" ToolTip.Tip="{Binding SupportText}"/></StackPanel>
        <Button Grid.Column="1" Content="{Binding L[Read]}" Click="ReadClicked" IsEnabled="{Binding CanRead}" VerticalAlignment="Top" Margin="14,0,0,0"/>
      </Grid>
      <TabControl Grid.Row="1" Name="Tabs">
        <TabItem Header="{Binding L[TabProfile]}" Width="138">
          <ScrollViewer Name="ProfileScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="0,12,6,10" IsEnabled="{Binding HasSnapshot}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><ComboBox ItemsSource="{Binding Profiles}" Name="ProfileList" SelectionChanged="ProfileChanged" IsEnabled="{Binding Idle}" ToolTip.Tip="{Binding EditingTargetText}"/><Button Grid.Column="1" Content="{Binding ActivateLabel}" Click="ActivateClicked" IsEnabled="{Binding CanActivate}" ToolTip.Tip="{Binding ActivationReason}"/></Grid>
              <Border Background="#F0F7F5" Padding="10,8" CornerRadius="4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding ActiveSlotText}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding TelemetryText}" TextWrapping="Wrap" MaxWidth="250"/></Grid></Border>
              <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="8" IsEnabled="{Binding CanSetCurrentDpi}" ToolTip.Tip="{Binding L[PreviewHint]}">
                <TextBlock Text="{Binding L[PreviewValue]}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <NumericUpDown Grid.Column="1" Name="CurrentDpiInput" AutomationProperties.Name="{Binding L[PreviewValue]}" Value="{Binding CurrentDpi}" Minimum="{Binding MinimumDpi}" Maximum="{Binding MaximumDpi}" Increment="{Binding DpiStep}"/>
                <Button Grid.Column="2" Content="{Binding L[SetCurrentDpi]}" Click="CurrentDpiClicked"/>
              </Grid>
              <Button Content="{Binding L[EndPreview]}" Click="EndPreviewClicked" IsVisible="{Binding Previewing}" IsEnabled="{Binding CanEndPreview}"/>
              <StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="{Binding EditingTargetText}" Classes="section" ToolTip.Tip="{Binding L[DpiDraftHint]}"/>
                <ItemsControl ItemsSource="{Binding Stages}" Name="DpiCards">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><Border Classes="dpi-stage" Classes.current="{Binding IsCurrent}" Padding="6" Margin="0,0,6,0"><StackPanel Spacing="4"><CheckBox IsChecked="{Binding Enabled}" Content="{Binding Index}"/><NumericUpDown AutomationProperties.Name="{Binding DpiLabel}" Value="{Binding Value}" Minimum="{Binding $parent[Window].DataContext.MinimumDpi}" Maximum="{Binding $parent[Window].DataContext.MaximumDpi}" Increment="{Binding $parent[Window].DataContext.DpiStep}" IsEnabled="{Binding Enabled}"/><TextBlock Text="{Binding StateLabel}" TextWrapping="Wrap" FontSize="10" MinHeight="14"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                  <StackPanel Spacing="4"><TextBlock Text="{Binding L[Default]}"/><ComboBox ItemsSource="{Binding StageNames}" SelectedIndex="{Binding DefaultIndex}"/></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding L[Shift]}"/><ComboBox ItemsSource="{Binding ShiftNames}" SelectedIndex="{Binding ShiftSelection}"/></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{Binding L[Rate]}"/><ComboBox ItemsSource="{Binding Rates}" SelectedItem="{Binding Rate}"/></StackPanel>
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding NeedsReplacementStage}"><TextBlock Text="{Binding L[ReplacementStage]}" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding StageNames}" SelectedIndex="{Binding ReplacementStage}" Width="180" HorizontalAlignment="Left"/></StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding L[TabButtons]}" Width="86">
          <Grid RowDefinitions="Auto,*" Margin="0,18,0,12" IsEnabled="{Binding HasSnapshot}">
            <TextBlock Text="{Binding ButtonProfileLabel}" Classes="section" Margin="0,0,0,14"/>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Grid IsVisible="{Binding HasButtonMap}" Width="240" RowDefinitions="Auto,Auto,*" RowSpacing="4">
                <TextBlock Text="{Binding L[TopView]}" HorizontalAlignment="Center" Classes="muted"/>
                <TextBlock Grid.Row="1" Text="{Binding L[SelectPhysicalButton]}" TextWrapping="Wrap" Classes="muted" FontSize="11" Margin="0,4,0,8"/><Viewbox Grid.Row="2" MaxWidth="232" MaxHeight="350" Stretch="Uniform" VerticalAlignment="Top"><Grid Width="216" Height="326">
                  <Image Source="avares://LightHub.Desktop/Assets/mouse.png" Width="216" Height="270" VerticalAlignment="Top"/>
                  <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="216" Height="326"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding MapX}"/><Setter Property="Canvas.Top" Value="{Binding MapY}"/></Style></ItemsControl.Styles>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Button Content="{Binding Number}" Width="32" Height="32" MinHeight="32" Padding="0" CornerRadius="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="hotspot" Classes.selected="{Binding Highlighted}" Click="ButtonMapClicked" ToolTip.Tip="{Binding Label}"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding L[BottomDpi]}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,263,0,0" Classes="muted" FontSize="11"/>
                </Grid></Viewbox>
              </Grid>
              <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" IsEnabled="{Binding CanEdit}">
                <ComboBox Name="ButtonSelector" ItemsSource="{Binding Buttons}" SelectedItem="{Binding SelectedButton}" AutomationProperties.Name="{Binding L[Buttons]}">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Row="1" Spacing="4">
                  <TextBlock Text="{Binding L[CurrentAction]}" Classes="muted"/>
                  <TextBlock Text="{Binding ButtonAssignment.CurrentAction.Label}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Name="CurrentAssignment"/>
                  <TextBlock Text="{Binding L[AssignmentDraftHint]}" TextWrapping="Wrap" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding L[ProtectedClickHint]}" TextWrapping="Wrap" Foreground="#9B4D13" IsVisible="{Binding ButtonAssignment.PrimaryProtected}"/>
                  <TextBlock Text="{Binding ButtonAssignment.OnboardMacroInfo}" TextWrapping="Wrap" Classes="muted" FontSize="11" IsVisible="{Binding ButtonAssignment.HasOnboardMacroInfo}" Name="OnboardMacroInfo"/>
                </StackPanel>
                <Grid Grid.Row="2" ColumnDefinitions="*,130" ColumnSpacing="8" IsEnabled="{Binding ButtonAssignment.CanAssign}">
                  <TextBox Text="{Binding ButtonAssignment.Search}" PlaceholderText="{Binding L[FindAction]}" AutomationProperties.Name="{Binding L[FindAction]}"/>
                  <ComboBox Grid.Column="1" Name="ActionGroup" ItemsSource="{Binding ButtonAssignment.Groups}" SelectedItem="{Binding ButtonAssignment.SelectedGroup, Mode=OneWay}" SelectionChanged="ActionGroupSelected"/>
                </Grid>
                <ListBox Grid.Row="3" Name="ActionList" ItemsSource="{Binding ButtonAssignment.Options}" SelectedItem="{Binding ButtonAssignment.CurrentAction, Mode=OneWay}" SelectionChanged="ActionSelected" IsEnabled="{Binding ButtonAssignment.CanAssign}" AutomationProperties.Name="{Binding L[ActionsAll]}"/>
                <WrapPanel Grid.Row="4">
                  <Button Content="{Binding $parent[Window].DataContext.L[Custom]}" DataContext="{Binding SelectedButton}" Click="CustomKeyClicked" IsEnabled="{Binding Editable}" Margin="0,0,8,4"/>
                  <Button Content="{Binding L[OpenMacroLibrary]}" Click="OpenMacrosClicked" Margin="0,0,0,4"/>
                </WrapPanel>
              </Grid>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding L[TabBackups]}" Width="92">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,20,0,0">
            <ItemsControl Grid.Row="0" ItemsSource="{Binding RecoveryGuide}" IsVisible="{Binding HasPendingTransactions}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#9B4D13" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="#9B4D13"/>
                    <TextBlock Text="{Binding $parent[Window].DataContext.L[RecoveryGuideHint]}" TextWrapping="Wrap" Classes="muted"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding BackupName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding $parent[Window].DataContext.L[RecoveryBackupMissing]}" Foreground="#9B4D13" VerticalAlignment="Center" IsVisible="{Binding !BackupAvailable}"/>
                      <Button Content="{Binding $parent[Window].DataContext.L[RecoveryRestoreBackup]}" Click="RecoveryRestoreClicked" IsEnabled="{Binding CanRestore}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Grid.Row="1" Orientation="Horizontal"><Button Content="{Binding L[Export]}" Click="ExportClicked" IsEnabled="{Binding CanRead}" Margin="0,0,12,12"/><Button Content="{Binding L[Restore]}" Click="RestoreClicked" IsEnabled="{Binding CanRead}" Margin="0,0,12,12"/><Button Content="{Binding L[Diagnostics]}" Click="DiagnosticsClicked" Margin="0,0,0,12"/></WrapPanel>
            <WrapPanel Grid.Row="2">
              <Button Content="{Binding L[ExportSelectedBackup]}" Click="ExportSelectedBackupClicked" IsEnabled="{Binding CanExportBackup}" Margin="0,0,8,8"/>
              <Button Content="{Binding L[RestoreSelectedBackup]}" Click="RestoreSelectedBackupClicked" IsEnabled="{Binding CanRestoreSelectedBackup}" Margin="0,0,8,8"/>
              <Button Content="{Binding L[DeleteBackups]}" Click="DeleteBackupsClicked" IsEnabled="{Binding CanDeleteBackups}" Margin="0,0,8,8"/>
              <Button Content="{Binding L[CleanupBackups]}" Click="CleanupBackupsClicked" IsEnabled="{Binding CanManageBackups}" Margin="0,0,8,8"/>
              <Button Content="↻" ToolTip.Tip="{Binding L[RefreshBackups]}" Click="RefreshBackupsClicked" IsEnabled="{Binding Idle}" Margin="0,0,0,8"/>
              <Button Content="{Binding L[PinBackup]}" Click="PinBackupClicked" IsEnabled="{Binding CanManageBackups}" Margin="8,0,0,8"/>
              <Button Content="{Binding L[NameBackup]}" Click="NameBackupClicked" IsEnabled="{Binding CanManageBackups}" Margin="8,0,0,8"/>
              <Button Content="{Binding L[Trash]}" Click="TrashClicked" IsEnabled="{Binding Idle}" Margin="8,0,0,8"/>
            </WrapPanel>
            <TextBlock Grid.Row="3" Text="{Binding BackupSummary}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ListBox Grid.Row="4" ItemsSource="{Binding Backups}" Name="BackupList" SelectionMode="Multiple" SelectionChanged="BackupSelectionChanged" DoubleTapped="BackupDoubleTapped">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><CheckBox IsChecked="{Binding $parent[ListBoxItem].IsSelected, Mode=TwoWay}" ToolTip.Tip="{Binding Title}"/><StackPanel Grid.Column="1" Spacing="4" Margin="0,5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Classes="muted"/><TextBlock Text="{Binding Name}" FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Expander Grid.Row="5" Header="{Binding L[DiagnosticDetails]}" HorizontalAlignment="Stretch" Margin="0,8,0,0"><TextBox Text="{Binding DiagnosticText}" IsReadOnly="True" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/></Expander>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding L[TabSupport]}" Width="132">
          <ScrollViewer><StackPanel Spacing="14" Margin="0,20,0,12"><TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Catalog}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DFE4E7" BorderThickness="0,0,0,1" Padding="0,14"><StackPanel Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Classes="muted"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" Foreground="#9B4D13"/></StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding L[Presets]}" Width="96">
          <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,18,0,12" RowSpacing="12" IsEnabled="{Binding Idle}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBox Text="{Binding PresetName}" MaxLength="120" PlaceholderText="{Binding L[PresetName]}"/><Button Grid.Column="1" Content="{Binding L[SavePreset]}" Click="SavePresetClicked" IsEnabled="{Binding CanEdit}"/></Grid>
            <WrapPanel Grid.Row="1"><Button Content="{Binding L[ImportPreset]}" Click="ImportPresetClicked" Margin="0,0,8,8"/><Button Content="{Binding L[ExportPreset]}" Click="ExportPresetClicked" Margin="0,0,8,8"/><Button Content="{Binding L[RecoverDraft]}" Click="RecoverDraftClicked" IsEnabled="{Binding CanEdit}" Margin="0,0,8,8"/></WrapPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>
            <WrapPanel Grid.Row="3"><Button Content="{Binding L[LoadPreset]}" Click="LoadPresetClicked" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/><Button Content="{Binding L[DeletePreset]}" Click="DeletePresetClicked" Margin="0,0,8,0"/><Button Content="{Binding L[RenamePreset]}" Click="RenamePresetClicked"/></WrapPanel>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding L[Macros]}" Name="MacrosTab" Width="82"><local:MacroEditorView Name="MacroEditor"/></TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#DFE4E7" BorderThickness="0,1,0,0" Padding="22,12" Background="#F8FAFA">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/><ProgressBar IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}" Height="3"/><TextBlock Text="{Binding DirtyText}" FontSize="11" Classes="muted"/></StackPanel>
        <Button Grid.Column="1" Content="{Binding L[Cancel]}" Click="CancelClicked" IsVisible="{Binding CanCancel}"/>
        <Button Grid.Column="2" Name="HardwareUndo" Content="{Binding L[Undo]}" Click="UndoClicked" IsEnabled="{Binding CanUndo}"/>
        <Button Grid.Column="3" Name="HardwareApply" Content="{Binding SaveTargetLabel}" Classes="primary" Click="ApplyClicked" IsEnabled="{Binding CanSaveToSlot}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
